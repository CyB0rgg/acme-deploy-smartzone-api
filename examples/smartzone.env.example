# ~/.acme.sh/smartzone.env  (chmod 600)
SZ_HOST=controller.example.com
SZ_PORT=8443
SZ_API=v13_0
SZ_USER=admin
SZ_PASS='change-me'
# Services to map. COMMUNICATOR is what your APs trust; leave it alone unless you know why.
SZ_SERVICES=MANAGEMENT_WEB,HOTSPOT
# Store name = <prefix>-<notAfter YYYYMMDD>, max 32 chars
SZ_NAME_PREFIX=acme
# Delete older unmapped certificates that start with the prefix
SZ_PRUNE=1
# Where the self-signed root is looked up (colon-separated)
SZ_CA_DIR=/etc/ssl/certs:/usr/share/ca-certificates/mozilla
# Set to 0 once the controller presents a certificate your host trusts
SZ_INSECURE=1
